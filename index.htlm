<!DOCTYPE html>
<html lang="tr">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>ADEC FC</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Anton&family=Manrope:wght@400;500;700;800&display=swap" rel="stylesheet">
<style>
  :root{
    --pitch:#0B120D;
    --turf:#1F6B3D;
    --turf-dark:#123D24;
    --gold:#D8A73D;
    --chalk:#F4F1E8;
    --line: rgba(244,241,232,0.14);
  }
  *{box-sizing:border-box; margin:0; padding:0;}
  body{
    font-family:'Manrope', sans-serif;
    background:var(--pitch);
    color:var(--chalk);
    min-height:100vh;
  }
  h1,h2,h3,.display{
    font-family:'Anton', sans-serif;
    font-weight:400;
    letter-spacing:0.5px;
    line-height:1;
  }

  /* ---------- LOGIN SCREEN ---------- */
  #login-screen{
    min-height:100vh;
    display:flex;
    align-items:center;
    justify-content:center;
    padding:24px;
    position:relative;
    overflow:hidden;
    background:
      repeating-linear-gradient(90deg, transparent 0 78px, var(--line) 78px 79px),
      radial-gradient(ellipse at 50% -10%, var(--turf-dark) 0%, var(--pitch) 60%);
  }
  #login-screen::before{
    content:"";
    position:absolute;
    width:520px; height:520px;
    border:2px solid var(--line);
    border-radius:50%;
    top:50%; left:50%;
    transform:translate(-50%,-50%);
  }
  .login-card{
    position:relative;
    z-index:2;
    width:100%;
    max-width:380px;
    background:rgba(11,18,13,0.75);
    border:1px solid var(--line);
    border-radius:4px;
    padding:40px 32px;
    backdrop-filter:blur(6px);
    animation:riseIn 0.6s ease-out;
  }
  @keyframes riseIn{
    from{opacity:0; transform:translateY(14px);}
    to{opacity:1; transform:translateY(0);}
  }
  .crest{
    width:64px; height:64px;
    margin:0 auto 18px;
    display:block;
  }
  .login-card h1{
    font-size:34px;
    text-align:center;
    color:var(--chalk);
  }
  .login-card .tag{
    text-align:center;
    color:var(--gold);
    font-size:13px;
    font-weight:700;
    margin-top:6px;
    margin-bottom:28px;
  }
  .field{ margin-bottom:16px; }
  .field label{
    display:block;
    font-size:12px;
    font-weight:700;
    color:rgba(244,241,232,0.6);
    margin-bottom:6px;
  }
  .field input{
    width:100%;
    padding:12px 14px;
    background:rgba(244,241,232,0.06);
    border:1px solid var(--line);
    border-radius:3px;
    color:var(--chalk);
    font-family:'Manrope', sans-serif;
    font-size:14px;
    outline:none;
    transition:border-color 0.15s ease;
  }
  .field input:focus{
    border-color:var(--gold);
  }
  .btn-primary{
    width:100%;
    padding:13px;
    margin-top:8px;
    background:var(--gold);
    color:var(--pitch);
    border:none;
    border-radius:3px;
    font-family:'Manrope', sans-serif;
    font-weight:800;
    font-size:14px;
    cursor:pointer;
    transition:filter 0.15s ease;
  }
  .btn-primary:hover{ filter:brightness(1.08); }
  .error-msg{
    color:#E5817C;
    font-size:13px;
    margin-top:12px;
    text-align:center;
    min-height:16px;
  }

  /* ---------- SITE ---------- */
  #site{ display:none; }
  header.topbar{
    display:flex;
    align-items:center;
    justify-content:space-between;
    padding:18px 32px;
    border-bottom:1px solid var(--line);
    position:sticky; top:0;
    background:rgba(11,18,13,0.92);
    backdrop-filter:blur(6px);
    z-index:10;
  }
  .brand{ display:flex; align-items:center; gap:10px; }
  .brand span{ font-family:'Anton'; font-size:20px; letter-spacing:0.5px; }
  .welcome-pill{
    font-size:13px;
    color:var(--gold);
    font-weight:700;
  }
  .logout-btn{
    background:transparent;
    border:1px solid var(--line);
    color:var(--chalk);
    padding:8px 16px;
    border-radius:3px;
    font-family:'Manrope';
    font-size:13px;
    font-weight:700;
    cursor:pointer;
  }
  .logout-btn:hover{ border-color:var(--gold); color:var(--gold); }

  .hero{
    padding:80px 32px 64px;
    text-align:center;
    background:radial-gradient(ellipse at 50% 0%, var(--turf-dark) 0%, var(--pitch) 65%);
    border-bottom:1px solid var(--line);
  }
  .hero h1{ font-size:64px; }
  .hero .sub{
    max-width:520px;
    margin:16px auto 0;
    color:rgba(244,241,232,0.7);
    font-size:15px;
    line-height:1.6;
  }
  .match-card{
    max-width:420px;
    margin:36px auto 0;
    border:1px solid var(--line);
    border-radius:4px;
    padding:20px 24px;
    display:flex;
    align-items:center;
    justify-content:space-between;
    background:rgba(244,241,232,0.03);
  }
  .match-card .team{ font-weight:800; font-size:15px; }
  .match-card .vs{ color:var(--gold); font-family:'Anton'; font-size:13px; }
  .match-card .meta{
    font-size:12px;
    color:rgba(244,241,232,0.55);
    margin-top:4px;
  }

  section{ padding:56px 32px; max-width:960px; margin:0 auto; }
  section h2{
    font-size:28px;
    margin-bottom:6px;
  }
  section .section-note{
    color:rgba(244,241,232,0.5);
    font-size:13px;
    margin-bottom:28px;
  }

  .roster-grid{
    display:grid;
    grid-template-columns:repeat(auto-fill, minmax(150px, 1fr));
    gap:14px;
  }
  .player-card{
    border:1px solid var(--line);
    border-radius:4px;
    padding:18px 14px;
    background:rgba(244,241,232,0.03);
    transition:transform 0.15s ease, border-color 0.15s ease;
  }
  .player-card:hover{
    transform:translateY(-3px);
    border-color:var(--gold);
  }
  .player-card .num{
    font-family:'Anton';
    font-size:30px;
    color:var(--gold);
  }
  .player-card .name{
    font-weight:700;
    font-size:14px;
    margin-top:6px;
  }
  .player-card .pos{
    font-size:12px;
    color:rgba(244,241,232,0.5);
    margin-top:2px;
  }
  .player-card .gastats{
    display:flex;
    gap:12px;
    margin-top:10px;
    padding-top:10px;
    border-top:1px solid var(--line);
    font-size:11px;
    color:rgba(244,241,232,0.6);
    font-weight:700;
  }
  .player-card .gastats b{ color:var(--gold); font-weight:800; }
  .player-card .gastats .gstat{ display:inline-flex; align-items:center; gap:5px; }
  .gol-controls{ display:none; gap:4px; }
  body.is-president .gol-controls{ display:inline-flex; }
  .gol-btn{
    width:18px; height:18px;
    border-radius:3px;
    border:1px solid var(--line);
    background:rgba(244,241,232,0.06);
    color:var(--chalk);
    font-family:'Manrope', sans-serif;
    font-size:12px;
    font-weight:800;
    line-height:1;
    display:flex;
    align-items:center;
    justify-content:center;
    padding:0;
    cursor:pointer;
  }
  .gol-btn:hover{ border-color:var(--gold); color:var(--gold); }

  .news-list{
    display:flex;
    flex-direction:column;
    gap:22px;
  }
  .news-card{
    border-left:3px solid var(--gold);
    padding:2px 0 2px 18px;
  }
  .news-card .news-date{
    font-size:11px;
    color:rgba(244,241,232,0.5);
    font-weight:700;
    margin-bottom:6px;
  }
  .news-card .news-title{
    font-size:17px;
    font-weight:800;
    margin-bottom:6px;
  }
  .news-card .news-body{
    font-size:13px;
    line-height:1.6;
    color:rgba(244,241,232,0.7);
  }

  .staff-grid{
    display:grid;
    grid-template-columns:repeat(auto-fill, minmax(150px, 1fr));
    gap:14px;
  }
  .staff-card{
    border:1px solid var(--line);
    border-radius:4px;
    padding:18px 14px;
    background:rgba(244,241,232,0.03);
    text-align:center;
  }
  .staff-card .role{
    font-size:11px;
    color:var(--gold);
    font-weight:800;
    margin-bottom:6px;
  }
  .staff-card .sname{
    font-weight:700;
    font-size:14px;
  }

  .stats-grid{
    display:grid;
    grid-template-columns:repeat(auto-fit, minmax(130px, 1fr));
    gap:14px;
  }
  .stat-card{
    border:1px solid var(--line);
    border-radius:4px;
    padding:24px 16px;
    text-align:center;
    background:rgba(244,241,232,0.03);
  }
  .stat-card .value{
    font-family:'Anton';
    font-size:38px;
    color:var(--gold);
  }
  .stat-card .label{
    font-size:12px;
    color:rgba(244,241,232,0.55);
    margin-top:4px;
    font-weight:700;
  }

  .perf-list{
    display:flex;
    flex-direction:column;
    gap:16px;
  }
  .perf-row{
    display:flex;
    align-items:center;
    gap:16px;
  }
  .perf-row .p-name{
    width:100px;
    flex-shrink:0;
    font-size:13px;
    font-weight:700;
  }
  .perf-row .p-bar-track{
    flex:1;
    height:10px;
    background:rgba(244,241,232,0.08);
    border-radius:5px;
    overflow:hidden;
  }
  .perf-row .p-bar-fill{
    height:100%;
    background:var(--gold);
    border-radius:5px;
  }
  .perf-row .p-value{
    width:24px;
    text-align:right;
    font-family:'Anton';
    color:var(--gold);
    font-size:16px;
  }

  .gallery-grid{
    display:grid;
    grid-template-columns:repeat(3, 1fr);
    gap:10px;
  }
  .gallery-grid div{
    aspect-ratio:1;
    border-radius:4px;
    background:linear-gradient(135deg, var(--turf-dark), var(--turf));
    border:1px solid var(--line);
  }

  footer{
    padding:32px;
    text-align:center;
    border-top:1px solid var(--line);
    color:rgba(244,241,232,0.4);
    font-size:12px;
  }

  @media (max-width:560px){
    .hero h1{ font-size:42px; }
    .gallery-grid{ grid-template-columns:repeat(2,1fr); }
  }
</style>
</head>
<body>

<!-- ================= LOGIN ================= -->
<div id="login-screen">
  <div class="login-card">
    <svg class="crest" viewBox="0 0 64 64" fill="none" xmlns="http://www.w3.org/2000/svg">
      <path d="M32 4 L58 14 V32 C58 46 47 56 32 60 C17 56 6 46 6 32 V14 Z" stroke="#D8A73D" stroke-width="2.5" fill="rgba(216,167,61,0.08)"/>
      <text x="32" y="40" font-family="Anton" font-size="24" fill="#D8A73D" text-anchor="middle">A</text>
    </svg>
    <h1>ADEC FC</h1>
    <div class="tag">SAHAYA ÇIK</div>

    <form id="login-form">
      <div class="field">
        <label for="email">E-posta</label>
        <input type="email" id="email" placeholder="ornek@mail.com" required>
      </div>
      <div class="field">
        <label for="password">Şifre</label>
        <input type="password" id="password" placeholder="••••••••" required>
      </div>
      <button type="submit" class="btn-primary">Giriş Yap</button>
      <div class="error-msg" id="error-msg"></div>
    </form>
  </div>
</div>

<!-- ================= SITE ================= -->
<div id="site">
  <header class="topbar">
    <div class="brand">
      <svg width="28" height="28" viewBox="0 0 64 64" fill="none" xmlns="http://www.w3.org/2000/svg">
        <path d="M32 4 L58 14 V32 C58 46 47 56 32 60 C17 56 6 46 6 32 V14 Z" stroke="#D8A73D" stroke-width="3" fill="rgba(216,167,61,0.08)"/>
      </svg>
      <span>ADEC FC</span>
    </div>
    <div style="display:flex; align-items:center; gap:16px;">
      <span class="welcome-pill" id="welcome-pill"></span>
      <button class="logout-btn" id="logout-btn">Çıkış Yap</button>
    </div>
  </header>

  <div class="hero">
    <h1>ADEC FC</h1>
    <p class="sub">Sahada birlikte ter döktüğümüz, dışarıda birbirimize kefil olduğumuz takım. Kadromuzu, maçlarımızı ve anılarımızı burada topluyoruz.</p>
    <div class="match-card">
      <div>
        <div class="team">ADEC FC</div>
        <div class="meta">Cumartesi · 20:00</div>
      </div>
      <div class="vs">VS</div>
      <div style="text-align:right;">
        <div class="team">Rakip Takım</div>
        <div class="meta">Halı Saha · Örnek Tesis</div>
      </div>
    </div>
  </div>

  <section>
    <h2>Haberler</h2>
    <div class="section-note">Kulüpten son gelişmeler — yeni haberleri buraya ekleyebilirsiniz.</div>
    <div class="news-list">
      <div class="news-card">
        <div class="news-date">Eylül 2026</div>
        <div class="news-title">ADEC FC kuruldu</div>
        <div class="news-body">Kadromuz belli oldu, teknik ekibimiz göreve başladı. Şimdi sırada sahaya çıkmak var.</div>
      </div>
      <div class="news-card">
        <div class="news-date">Yakında</div>
        <div class="news-title">İlk maç tarihi netleşiyor</div>
        <div class="news-body">İlk resmi maçımızın tarihi ve rakibi belli olduğunda burada duyurulacak.</div>
      </div>
    </div>
  </section>

  <section>
    <h2>İstatistikler</h2>
    <div class="section-note">Henüz maç yapmadık — sezon başladığında burası güncellenecek.</div>
    <div class="stats-grid">
      <div class="stat-card"><div class="value">0</div><div class="label">Oynanan</div></div>
      <div class="stat-card"><div class="value">0</div><div class="label">Galibiyet</div></div>
      <div class="stat-card"><div class="value">0</div><div class="label">Beraberlik</div></div>
      <div class="stat-card"><div class="value">0</div><div class="label">Mağlubiyet</div></div>
      <div class="stat-card"><div class="value" id="stat-goals">0</div><div class="label">Atılan Gol</div></div>
      <div class="stat-card"><div class="value">0</div><div class="label">Yenilen Gol</div></div>
    </div>
  </section>

  <section>
    <h2>Kadro</h2>
    <div class="section-note">Gol sayıları sıfırdan başlar. Gol ekleme/çıkarma sadece başkan girişinde açılır.</div>
    <div class="roster-grid" id="roster-grid"></div>
  </section>

  <section>
    <h2>Teknik Ekip</h2>
    <div class="staff-grid">
      <div class="staff-card">
        <div class="role">Teknik Direktör</div>
        <div class="sname">Kürşad Demir</div>
      </div>
    </div>
  </section>

  <section>
    <h2>Performans</h2>
    <div class="section-note">Sezonun gol sıralaması — en formda oyuncular en üstte.</div>
    <div class="perf-list" id="perf-list"></div>
  </section>

  <section>
    <h2>Galeri</h2>
    <div class="section-note">Maç ve antrenman fotoğraflarınızı buraya ekleyebilirsiniz.</div>
    <div class="gallery-grid">
      <div></div><div></div><div></div>
      <div></div><div></div><div></div>
    </div>
  </section>

  <footer>ADEC FC © 2026 — arkadaşlar arası kurulmuştur.</footer>
</div>

<script>
  const PRESIDENT_EMAIL = "ercandeno1905@gmail.com";

  const loginScreen = document.getElementById('login-screen');
  const site = document.getElementById('site');
  const form = document.getElementById('login-form');
  const errorMsg = document.getElementById('error-msg');
  const welcomePill = document.getElementById('welcome-pill');
  const logoutBtn = document.getElementById('logout-btn');

  const players = [
    { id:'fatih', name:'Fatih', pos:'Kaleci', num:1, goals:0, assists:0 },
    { id:'ercan', name:'Ercan', pos:'Orta Saha · Kaptan / Başkan', num:10, goals:0, assists:0 },
    { id:'deniz', name:'Deniz', pos:'Sol Kanat', num:11, goals:0, assists:0 },
    { id:'mert', name:'Mert', pos:'Forvet', num:9, goals:0, assists:0 },
    { id:'kaan', name:'Kaan', pos:'Yedek · Genç Oyuncu', num:16, goals:0, assists:0 },
    { id:'alp', name:'Alp', pos:'Yedek', num:5, goals:0, assists:0 },
    { id:'aras', name:'Aras', pos:'Yedek', num:8, goals:0, assists:0 }
  ];

  function renderRoster(){
    const grid = document.getElementById('roster-grid');
    grid.innerHTML = players.map(function(p){
      return '<div class="player-card">' +
        '<div class="num">' + p.num + '</div>' +
        '<div class="name">' + p.name + '</div>' +
        '<div class="pos">' + p.pos + '</div>' +
        '<div class="gastats">' +
          '<span class="gstat">Gol <b id="gol-' + p.id + '">' + p.goals + '</b>' +
            '<span class="gol-controls">' +
              '<button class="gol-btn" data-id="' + p.id + '" data-delta="1">+</button>' +
              '<button class="gol-btn" data-id="' + p.id + '" data-delta="-1">−</button>' +
            '</span>' +
          '</span>' +
          '<span class="gstat">Asist <b>' + p.assists + '</b></span>' +
        '</div>' +
      '</div>';
    }).join('');

    grid.querySelectorAll('.gol-btn').forEach(function(btn){
      btn.addEventListener('click', function(){
        const id = this.dataset.id;
        const delta = parseInt(this.dataset.delta, 10);
        const player = players.find(function(pl){ return pl.id === id; });
        player.goals = Math.max(0, player.goals + delta);
        renderRoster();
        renderPerformance();
        updateTeamGoalsStat();
      });
    });
  }

  function renderPerformance(){
    const list = document.getElementById('perf-list');
    const maxGoals = Math.max(1, ...players.map(function(p){ return p.goals; }));
    const sorted = players.slice().sort(function(a,b){ return b.goals - a.goals; });
    list.innerHTML = sorted.map(function(p){
      const width = (p.goals / maxGoals * 100);
      return '<div class="perf-row">' +
        '<div class="p-name">' + p.name + '</div>' +
        '<div class="p-bar-track"><div class="p-bar-fill" style="width:' + width + '%"></div></div>' +
        '<div class="p-value">' + p.goals + '</div>' +
      '</div>';
    }).join('');
  }

  function updateTeamGoalsStat(){
    const total = players.reduce(function(sum,p){ return sum + p.goals; }, 0);
    document.getElementById('stat-goals').textContent = total;
  }

  renderRoster();
  renderPerformance();
  updateTeamGoalsStat();

  form.addEventListener('submit', function(e){
    e.preventDefault();
    const email = document.getElementById('email').value.trim().toLowerCase();
    const password = document.getElementById('password').value;

    if(!email || !password){
      errorMsg.textContent = "Lütfen e-posta ve şifreni gir.";
      return;
    }

    errorMsg.textContent = "";

    if(email === PRESIDENT_EMAIL){
      welcomePill.textContent = "Başkanım hoş geldin";
      document.body.classList.add('is-president');
    } else {
      welcomePill.textContent = "Oyuncu hoş geldin";
      document.body.classList.remove('is-president');
    }

    loginScreen.style.display = 'none';
    site.style.display = 'block';
    window.scrollTo(0,0);
  });

  logoutBtn.addEventListener('click', function(){
    site.style.display = 'none';
    loginScreen.style.display = 'flex';
    form.reset();
  });
</script>

</body>
</html>
